-        return false;
-    }
-
-    if (!memcpyAndValidate((void*)(pageStart + pageOffset), bufferPtr.get(), bufferSize)) {
-        if (!writeWithVMWrite((void*)(pageStart + pageOffset), bufferPtr.get(), bufferSize)) {
-            THLog(MEMCPY_ERROR_MSG);
